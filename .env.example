# 配置示例：不要在本文件中填写真实密钥，也不要把密钥发到聊天或 GitHub。
# 本文件变量由 docker compose 读取（frontend 的 NEXT_PUBLIC_API_BASE_URL 在构建期使用）。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# false：纯本地规则模式；true：使用模型理解自然语言，失败时仍自动回退。
AGENT_LLM_ENABLED=false

# 后端允许哪些前端页面跨域访问（逗号分隔），默认本地 3000。
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 浏览器访问后端的地址（构建期烧进前端产物），默认本地 8080。
# 注意：docker compose 需要重新 build 前端才会生效：
#   docker compose build frontend && docker compose up -d frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
