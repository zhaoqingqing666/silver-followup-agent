# 配置示例：不要在本文件中填写真实密钥，也不要把密钥发到聊天或 GitHub。
# 本文件变量由 docker compose 读取（frontend 的 NEXT_PUBLIC_API_BASE_URL 在构建期使用）。
# 当前适配 OpenAI-compatible /chat/completions 协议；更换厂商时只改配置。
AGENT_MODEL_ENABLED=false
AGENT_MODEL_PROVIDER=openai-compatible
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=
AGENT_MODEL_API_KEY=
# 本地无鉴权模型可设为 false。
AGENT_MODEL_API_KEY_REQUIRED=true
# 某些兼容服务不支持 response_format=json_object，遇到报错时设为 false。
AGENT_MODEL_JSON_MODE_SUPPORTED=true
# 模型连接与单次响应超时；失败后自动回退规则或权威模板。
AGENT_MODEL_CONNECT_TIMEOUT_MS=2500
AGENT_MODEL_READ_TIMEOUT_MS=12000
# 最近模型上下文消息条数，默认16条（约8轮），可在4到40之间调整。
AGENT_MODEL_HISTORY_LIMIT=16

# 后端允许哪些前端页面跨域访问（逗号分隔），默认本地 3000。
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 浏览器访问后端的地址（构建期烧进前端产物），默认本地 8080。
# 注意：docker compose 需要重新 build 前端才会生效：
#   docker compose build frontend && docker compose up -d frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 可选：配置后显示高德底图；不配置时自动使用比赛模拟路线图。
# Web 服务 Key 不要写在 NEXT_PUBLIC 变量中，下面仅用于浏览器 JS API。
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
