# 配置示例：不要在本文件中填写真实密钥，也不要把密钥发到聊天或 GitHub。

# ===== 阿里云百炼 DashScope（推荐） =====
# 核心 Agent（Qwen3.6-Flash），走 OpenAI 兼容 chat/completions 接口
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.6-flash
# 你的百炼 API Key（在 https://bailian.console.aliyun.com/ 获取）
DASHSCOPE_API_KEY=

# ===== 也可以用旧的 DeepSeek（保留兼容，默认已切到百炼） =====
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=

# false：纯本地规则模式；true：使用模型理解自然语言，失败时仍自动回退。
AGENT_LLM_ENABLED=false
