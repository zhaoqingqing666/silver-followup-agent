data/

# Frontend local cache (not source)
frontend/.npm-cache/

# Docker compose 本地配置：把 .env.example 复制为 .env 再填真实密钥
.env
.env.*
!.env.example

# Dev container 本机私有配置（不进仓库）
.devcontainer/.env
!.devcontainer/.env.example

# 内部开发笔记：实测踩坑与易错点，只供团队内部参考，不进仓库
docs/13-agent-pitfalls.md

