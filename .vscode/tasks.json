{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Container: 后端服务",
      "type": "shell",
      "command": "test -f /.dockerenv && mvn spring-boot:run",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Dev Container: 前端服务",
      "type": "shell",
      "command": "test -f /.dockerenv && npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Dev Container: 验证项目",
      "type": "shell",
      "command": "test -f /.dockerenv && mvn -B -f backend/pom.xml test -Dagent.llm.enabled=false && cd frontend && npx tsc --noEmit && npm run build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
