# VS Code Dev Container 的后端模型配置示例。
# 复制为 .devcontainer/.env 后填写；真实密钥不要提交 Git。

AGENT_MODEL_ENABLED=false
AGENT_MODEL_PROVIDER=openai-compatible
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=
AGENT_MODEL_API_KEY=

# 本地无鉴权模型可设为 false。
AGENT_MODEL_API_KEY_REQUIRED=true

# 某些兼容服务不支持 response_format=json_object，遇到报错时设为 false。
AGENT_MODEL_JSON_MODE_SUPPORTED=true

# 模型连接与单次响应超时；失败后自动回退规则或权威模板。
AGENT_MODEL_CONNECT_TIMEOUT_MS=2500
AGENT_MODEL_READ_TIMEOUT_MS=12000
# 最近模型上下文消息条数，默认16条（约8轮），可在4到40之间调整。
AGENT_MODEL_HISTORY_LIMIT=16

# ---- 阿里云百炼（DashScope）：拍照识图 / 语音识别 / 语音播报 ----
# 一把 key 同时覆盖视觉、语音识别、语音合成三个通道，申请地址：
# https://bailian.console.aliyun.com/
# 留空时这三个能力一律显示「未开启」，前端自动走浏览器原生降级：
# 语音播报用浏览器朗读、语音输入用浏览器识别；只有拍照识图没有本地替代。
DASHSCOPE_API_KEY=

# 视觉（图片识别）与语音识别走 OpenAI 兼容端点；语音合成走百炼原生端点。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_TTS_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_VL_MODEL=qwen3-vl-plus
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
# 音色可选：Cherry / Serena / Chelsie / Momo / Vivian / Maia / Ethan / Moon
DASHSCOPE_TTS_VOICE=Cherry
DASHSCOPE_TTS_SPEED=1.0

# 三个通道各自的总开关；不设时跟随 AGENT_MODEL_ENABLED，且仍然要求 DASHSCOPE_API_KEY 非空。
# 这三行默认注释掉：留成空值会被当成「设成了空字符串」而不是「没设」，布尔解析会出问题。
# AGENT_VL_ENABLED=true
# AGENT_ASR_ENABLED=true
# AGENT_TTS_ENABLED=true

# 可选的高德 Web 端 JS API 配置；留空时前端使用稳定的比赛模拟地图。
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
